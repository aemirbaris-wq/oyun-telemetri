  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnlatimNesnesi
  tur: 0
  kayitKodu: bolum1_gunah_1
  erdemSirasi: 1
  baslikTr: "B\xD6L\xDCM I \u2014 A\u011EIRLA\u015EAN G\xD6LGE"
  icerikTr: "Ad\u0131mlar\u0131m her ge\xE7en an daha da a\u011F\u0131rla\u015F\u0131yor.
    Yukar\u0131daki \u0131\u015F\u0131k \xE7oktan geride kald\u0131; yine de durmayaca\u011F\u0131m,
    onu bu karanl\u0131ktan \xE7ekip alaca\u011F\u0131m."
  baslikEn: "CHAPTER I \u2014 THE HEAVY SHADOW"
  icerikEn: My steps grow heavier with every passing moment. The light above is long
    behind me; still I will not stop, I will pull her out of this dark.
  etkilesimMesafesi: 1.75
