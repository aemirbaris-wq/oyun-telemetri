  kayitKodu: bolum1_erdem_1
  erdemSirasi: 1
  baslikTr: "I. ERDEM \u2014 UYANI\u015E VE \xC7ABA"
  icerikTr: "\"Beni karanl\u0131\u011F\u0131n i\xE7inde aramaktan vazge\xE7 sevgilim...
